<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
           http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- 1. Product를 Setter Injection으로 설정 -->
    <bean id="product1" class="mylab.order.di.xml.Product">
        <property name="id" value="P001" />
        <property name="name" value="노트북" />
        <property name="price" value="150000" />
    </bean>

    <!-- 2. Product를 Constructor Injection으로 설정 -->
    <bean id="product2" class="mylab.order.di.xml.Product">
        <constructor-arg index="0" value="P002" />
        <constructor-arg index="1" value="스마트폰" />
        <constructor-arg index="2" value="800000" />
    </bean>

    <!-- 3. ShoppingCart에 Product 객체 목록을 Setter Injection -->
    <bean id="shoppingCart" class="mylab.order.di.xml.ShoppingCart">
        <property name="products">
            <list>
                <ref bean="product1" />
                <ref bean="product2" />
            </list>
        </property>
    </bean>

    <!-- 4. OrderService에 ShoppingCart를 Setter Injection -->
    <bean id="orderService" class="mylab.order.di.xml.OrderService">
        <property name="shoppingCart" ref="shoppingCart" />
    </bean>

</beans>